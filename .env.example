# === Trading System — Environment Template ===
# Copy to .env and fill in real values. .env is gitignored — NEVER commit it.

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Data lake
DYNAMODB_TABLE=trading-data
S3_BUCKET=trading-datalake-920641308584

# Market data APIs (free tiers)
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
NEWS_API_KEY=
SERPER_API_KEY=
BINANCE_US_API_KEY=
BINANCE_US_SECRET=

# Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_ACCOUNT=

# Risk sleeves (USD) — per-bot trading budget, NOT full account NetLiq
RISK_BUDGET=50000
BONDFX_RISK_BUDGET=25000
INTRA_RISK_BUDGET=25000

# Paper only — flip to true for real money (fail-closed: defaults to false)
LIVE=false

# ---- Data-collector tuning (optional; all have sane defaults) ----
# TICK_SYMBOLS=ES,NQ,MES,MNQ          # L1 tick stream subset (default: full registry)
# YF_PACING_S=1.5                     # yfinance sleep between symbols
# FRED_PACING_S=1.0                   # FRED sleep between series
# BACKFILL_PACING_S=10                # IBKR backfill pacing between requests
# DAILY_COLLECT_PACING_S=3            # IBKR daily-delta pacing

# TradingView
TRADINGVIEW_SESSIONID=
TRADINGVIEW_SIGN=
